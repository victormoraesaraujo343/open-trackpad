<?xml version="1.0" encoding="utf-8"?>
<!-- A row that can be picked: inset, with a hairline that goes lime when taken. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1B1D1F" />
            <stroke android:width="1dp" android:color="?attr/otpLime" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1B1D1F" />
            <stroke android:width="1dp" android:color="?attr/otpHairline" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
