<?xml version="1.0" encoding="utf-8"?>
<!--
  One key of a combination, drawn as a cap rather than as a word.

  The heavier bottom edge is the whole trick: it is the only thing that makes a
  flat rectangle read as something with a top surface, and it costs one line.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/otpCapEdge" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/otpRaised" />
            <stroke android:width="1dp" android:color="?attr/otpCapEdge" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
