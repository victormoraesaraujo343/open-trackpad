<?xml version="1.0" encoding="utf-8"?>
<!--
  The chip that makes a shortcut rather than being one.

  Dashed and unfilled on purpose, from the artboard: every other chip in this
  list is a thing you can pick up and put somewhere, and this one is not. The
  outline says so before anybody has to find out by pressing it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <stroke
        android:width="1dp"
        android:color="@color/hairline"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
</shape>
