    <!-- Why the panel has nothing to show. Each says what to do about it. -->
    <string name="audio_none_outputs">No outputs</string>
    <string name="audio_none_inputs">No inputs</string>
    <string name="audio_none_apps">Nothing is playing</string>
    <string name="audio_no_tool">Your computer has no way to talk to its sound system.</string>
    <string name="audio_no_daemon">No sound system is running on your computer.</string>
    <string name="audio_lost">The sound system stopped. Looking for it.</string>

    <string name="audio_boost">Allow louder than 100%</string>
    <string name="audio_boost_note">Rescues a quiet video. Distorts the sound, and at high volume can damage speakers and ears. Anything past 100% turns amber on the fader.</string>
    <string name="audio_opens_on">Opens on</string>
    <string name="audio_opens_on_note">The page this panel shows first, every time.</string>

    <!-- The rails, for a screen reader. -->
    <string name="rail_shortcuts">Shortcuts</string>
    <string name="rail_overflow">More shortcuts</string>

    <!--
      A problem takes over the middle of the screen: there is no status bar to
      put it in, and a peripheral that has quietly stopped working is worse than
      one that says so.
    -->
    <string name="trouble_seeking">Looking for your computer</string>

    <string name="unplugged_title">The cable came out</string>
    <string name="unplugged_body">Plug it back in. It reconnects on its own — nothing to press.</string>
    <string name="unplugged_note">Every key that was being held was let go, so nothing is stuck on the other side.</string>

    <string name="busy_title">Something else is the trackpad</string>
    <string name="busy_body">Your computer already has a phone connected — most likely the older OpenTrackpad on this one. Close that app and this one takes over.</string>
    <string name="busy_note">Only one app can hold the connection, so this one waits rather than interrupting a session mid-gesture.</string>

    <string name="mismatch_title">The two halves do not match</string>
    <string name="mismatch_body">This app speaks a newer language than the OpenTrackpad on your computer. Update the computer side and it will connect again.</string>
    <string name="mismatch_note">Until then the trackpad still works, without the rails. Tap to carry on that way.</string>
    <string name="mismatch_phone_label">This phone</string>
    <string name="mismatch_host_label">Your computer</string>
    <string name="mismatch_speaks">speaks %1$s</string>

    <string name="incompatible_title">That is not OpenTrackpad</string>
    <string name="incompatible_body">Something is listening on the port but it is not the OpenTrackpad host. Check what else is using it on the computer.</string>

    <string name="setup_hint">Run adb reverse tcp:4242 tcp:4242 on the computer</string>
</resources>
