<?xml version="1.0" encoding="utf-8"?>
<!--
  One shortcut in the library, ready to be dragged onto a rail.

  Its chord under its name, because two shortcuts can easily share a name on a
  machine that has both a desktop's and a person's own version of the same idea.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="7dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chip_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:singleLine="true"
            android:textColor="@color/secondary"
            android:textSize="10sp"
            tools:text="Show all windows" />

        <TextView
            android:id="@+id/chip_chord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:singleLine="true"
            android:textColor="@color/faint"
            android:textSize="9sp"
            tools:text="super+w" />
    </LinearLayout>

    <!-- Only what the person made themselves is theirs to change. -->
    <View
        android:id="@+id/chip_mine"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/mine_dot" />
</LinearLayout>
