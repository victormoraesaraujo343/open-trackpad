<?xml version="1.0" encoding="utf-8"?>
<!--
  The profile editor, from ProfileEditor.dc.html.

  Both rails and the library they are filled from on one screen, because
  picking from a modal hides the thing being changed at the moment of change.
  Drag a shortcut from the right onto a slot on the left.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editor_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/otpGround"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/editor_back"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/settings_back"
            android:focusable="true"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/editor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/space_grotesk_semibold"
            android:textColor="?attr/otpInk"
            android:tag="14"
            android:textSize="13sp"
            tools:text="Desktop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter_regular"
            android:text="@string/editor_profile"
            android:textColor="?attr/otpFaint"
            android:tag="12"
            android:textSize="10sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/editor_duplicate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_regular"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:text="@string/editor_duplicate"
            android:textColor="?attr/otpBody"
            android:tag="13"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/editor_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_regular"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:text="@string/editor_reset"
            android:textColor="?attr/otpBody"
            android:tag="13"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/editor_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/lime_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_medium"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:text="@string/editor_save"
            android:textColor="?attr/otpGround"
            android:tag="13"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/editor_rail_shortcuts"
            style="@style/SettingsCard"
            android:layout_width="132dp"
            android:layout_height="match_parent"
            android:padding="10dp" />

        <LinearLayout
            android:id="@+id/editor_rail_overflow"
            style="@style/SettingsCard"
            android:layout_width="132dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:padding="10dp" />

        <LinearLayout
            style="@style/SettingsCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:padding="10dp">

            <EditText
                android:id="@+id/editor_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/chip"
                android:fontFamily="@font/inter_regular"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="9dp"
                android:paddingVertical="6dp"
                android:textColor="?attr/otpSecondary"
                android:textColorHint="?attr/otpFaint"
                android:tag="13"
                android:textSize="11sp"
                tools:hint="Search 54 shortcuts" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/editor_groups"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <!--
                  Two columns, worked out from the shipped font rather than
                  taken from the drawing: the artboard draws three, and was
                  drawn when the type floor was ten units. At thirteen, three
                  columns cut "Toggle Present Windows" and "Show Desktop Grid",
                  which are ordinary names off a KDE desktop. See
                  LibraryGridTest.

                  It scrolls where the artboard clips. A drawing is one frame
                  and cuts the last row to admit there are more; the app has to
                  let somebody reach all fifty-four of them.
                -->
                <GridLayout
                    android:id="@+id/editor_library"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
