<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole control surface: a rail, the pad, a rail, and nothing else. There is
  no header and no status bar by design — every pixel that is not a rail belongs
  to the touch surface — so a problem with the session has to take over the
  middle of the screen instead, which is what @id/trouble does. The middle, and
  not the rails: it is clickable, so anything it covers becomes unpressable, and
  covering the rails locked somebody unplugged out of the whole app. MainActivity
  insets it to the pad, where the rail width is known.

  How rails and touch stay apart lives here rather than in code. The rails and
  the pad are siblings that never overlap, so Android's own hit testing decides
  which of them a finger belongs to, and splitMotionEvents means it decides that
  per finger rather than per gesture: a thumb on a shortcut and three fingers
  swiping the pad are two independent streams. The pad therefore only ever sees
  contacts that started on the pad, and a finger that slides off it stays with
  it until it lifts, so no contact can be left behind on the host.

  Sizes here carry an `android:tag` giving their size in artboard units, which
  Typography applies at runtime; the sp value beside it is only so the editor
  preview renders something. A unit is a fixed physical length, so a rail is the
  same width in millimetres on every phone, and text is that length multiplied
  by the font scale — the one system setting that is about reading rather than
  about layout. There was a note here saying the opposite, written when this was
  in dp and a rail was 70 of them. Both numbers and the rule have moved; see
  Artboard.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/otpGround">

    <LinearLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/edge"
        android:splitMotionEvents="true">

        <org.opentrackpad.client.RailView
            android:id="@+id/rail_start"
            android:layout_width="@dimen/rail_width"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/pad_holder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/edge"
            android:splitMotionEvents="true">

            <org.opentrackpad.client.TouchSurfaceView
                android:id="@+id/touch_surface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/pad_description" />

            <!--
              Sits over the pad and is deliberately not clickable, so a touch
              lands straight through it on the surface below. It is registered
              with ScreenCare because it never moves and would otherwise burn
              into an OLED panel over a few hundred hours on a desk.
            -->
            <TextView
                android:id="@+id/pad_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="13dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:text="@string/pad_hint"
                android:fontFamily="@font/inter_regular"
                android:textColor="?attr/otpFaint"
                android:tag="12"
                android:textSize="10dp"
                tools:ignore="SpUsage" />

            <!--
              Over the pad and nothing else. It covers exactly the surface it
              dims, so the rails stay reachable behind it — the slot that opened
              the ring is also the slot that closes it, and it would be a poor
              trick to put it out of reach.
            -->
            <!-- Takes the pad's place while it is open, rather than sitting
                 over it: it is a page, not a menu. -->
            <include layout="@layout/panel_audio" />

            <org.opentrackpad.client.QuickRingView
                android:id="@+id/quick_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/ring_description"
                android:visibility="gone" />

            <!--
              Over the pad, like the ring, and for the same reason: switching
              profile is a glance and a tap, and it is the one panel where you
              want to watch the rails change behind it.
            -->
            <org.opentrackpad.client.ProfileMenuView
                android:id="@+id/profile_menu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/profile_heading"
                android:visibility="gone" />

        </FrameLayout>

        <org.opentrackpad.client.RailView
            android:id="@+id/rail_end"
            android:layout_width="@dimen/rail_width"
            android:layout_height="match_parent" />

    </LinearLayout>

    <!--
      Above the pad and below the panels, and clickable, so the pad cannot be
      used while the session is broken.

      It used to be last, which put it over everything including the Quick Ring
      the person had just opened, and `match_parent`, which made it swallow both
      rails — so somebody unplugged could reach no part of the app but this.

      A note here said that was "the same statement the dead rails make". It was
      not: the dead rails deliberately leave the Quick Ring alive, because it is
      the way in to settings, profiles and the editor, and none of those need a
      computer. This closed that door instead of drawing it shut. MainActivity
      now insets it to the pad.
    -->
    <FrameLayout
        android:id="@+id/trouble"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/otpScrim"
        android:clickable="true"
        android:focusable="true"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/trouble_card"
            android:layout_width="430dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingVertical="22dp">

            <ImageView
                android:id="@+id/trouble_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_unplugged" />

            <TextView
                android:id="@+id/trouble_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:gravity="center"
                android:fontFamily="@font/space_grotesk_semibold"
                android:textColor="?attr/otpInk"
                android:tag="19"
                android:textSize="19dp"
                tools:ignore="SpUsage" />

            <TextView
                android:id="@+id/trouble_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:fontFamily="@font/inter_regular"
                android:textColor="?attr/otpBody"
                android:tag="14"
                android:textSize="13dp"
                tools:ignore="SpUsage" />

            <!-- Which version each side speaks. Only the mismatch needs it. -->
            <LinearLayout
                android:id="@+id/trouble_versions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip"
                    android:orientation="vertical"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="9dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mismatch_phone_label"
                        android:fontFamily="@font/inter_regular"
                        android:textColor="?attr/otpMuted"
                        android:tag="12"
                        android:textSize="10dp"
                        tools:ignore="SpUsage" />

                    <TextView
                        android:id="@+id/trouble_phone_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="?attr/otpInk"
                        android:tag="14"
                        android:textSize="13dp"
                        tools:ignore="SpUsage" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/chip"
                    android:orientation="vertical"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="9dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mismatch_host_label"
                        android:fontFamily="@font/inter_regular"
                        android:textColor="?attr/otpMuted"
                        android:tag="12"
                        android:textSize="10dp"
                        tools:ignore="SpUsage" />

                    <TextView
                        android:id="@+id/trouble_host_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="?attr/otpAmber"
                        android:tag="14"
                        android:textSize="13dp"
                        tools:ignore="SpUsage" />
                </LinearLayout>
            </LinearLayout>

            <!-- Still trying. A card with no pulse reads as a card that gave up. -->
            <LinearLayout
                android:id="@+id/trouble_seeking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/trouble_pulse"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/seeking_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trouble_seeking"
                    android:fontFamily="@font/inter_regular"
                        android:textColor="?attr/otpMuted"
                    android:tag="13"
                    android:textSize="11dp"
                    tools:ignore="SpUsage" />
            </LinearLayout>

            <TextView
                android:id="@+id/trouble_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.45"
                android:fontFamily="@font/inter_regular"
                android:textColor="?attr/otpFaint"
                android:tag="12"
                android:textSize="10dp"
                tools:ignore="SpUsage" />

        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/panel_settings" />
    <include layout="@layout/panel_import" />
    <include layout="@layout/panel_editor" />
    <include layout="@layout/panel_name" />
    <include layout="@layout/panel_recording" />


</FrameLayout>
